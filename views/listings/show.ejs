<% layout("/layouts/boilerplate") -%>

<script>
  const coordinates = <%- JSON.stringify(listing.geometry?.coordinates || [77.1025, 28.7041]) %>;
  const mapToken = "<%= mapToken %>";
</script>

<div class="container mt-4">
  <div class="row">

    <div class="col-8 offset-2">

      <h2 class="mb-3"><%= listing.title %></h2>

      <div class="card mb-3 show-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img">

        <div class="card-body">
          <p class="card-text">
            <i>Owned by <%= listing.owner.username %></i>
          </p>

          <p class="card-text">
            <%= listing.description %><br>
            <strong>₹ <%= (listing?.price ?? 0).toLocaleString("en-IN") %></strong><br>
            <%= listing.location %><br>
            <%= listing.country %>
          </p>

          <% if(currUser && currUser._id.toString() === listing.owner._id.toString()) { %>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger">Edit</a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button class="btn btn-dark">Delete</button>
            </form>
          <% } %>
        </div>
      </div>

      <div id="map" ></div>

      <div class="mt-4">
        <h4>Leave a Review</h4>

         <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <legend>First rating:</legend>

              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1">1 star</label>

              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2">2 stars</label>

              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3">3 stars</label>

              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4">4 stars</label>

              <input type="radio" id="first-rate5" name="review[rating]" value="5" checked/>
              <label for="first-rate5">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" id="comment" rows="3" class="form-control" required></textarea>
          </div>

          <button class="btn btn-outline-dark">Submit</button>
        </form>
      </div>

      <div class="mt-5">
        <h4>All Reviews</h4>

        <% listing.reviews.forEach((review) => { %>
          <div class="card mb-3">
            <div class="card-body">

              <h5 class="card-title">
                <%= review.author?.username || "Anonymous" %>
              </h5>

              <p class="card-text">
                <%= review.comment %>
              </p>

              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>

            </div>
          </div>
        <% }) %>

      </div>

    </div>

  </div>
</div>

